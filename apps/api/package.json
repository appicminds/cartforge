{
  "name": "@cartforge/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node --env-file-if-exists=../../.env dist/main.js\"",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@cartforge/config": "workspace:*",
    "@cartforge/database": "workspace:*",
    "@cartforge/types": "workspace:*",
    "@cartforge/validation": "workspace:*",
    "@nestjs/common": "11.1.9",
    "@nestjs/core": "11.1.9",
    "@nestjs/platform-express": "11.1.9",
    "@nestjs/swagger": "11.2.3",
    "argon2": "0.44.0",
    "cookie-parser": "1.4.7",
    "helmet": "8.1.0",
    "ioredis": "5.8.2",
    "nestjs-pino": "4.4.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.18.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.9",
    "@swc/core": "1.13.5",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.5",
    "@types/node": "22.19.1",
    "@types/sanitize-html": "2.16.0",
    "@types/supertest": "6.0.3",
    "pino-pretty": "13.1.2",
    "supertest": "7.1.4",
    "tsc-watch": "7.2.0",
    "unplugin-swc": "1.5.8",
    "vitest": "3.2.4"
  }
}
