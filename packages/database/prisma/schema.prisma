// CartForge database schema.
// Conventions (PRD §25.4): UUID PKs, store_id on every store-owned row,
// snake_case columns, created_at/updated_at everywhere, money as *_minor BIGINT.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Identity ─────────────────────────────

enum UserStatus {
  active
  disabled
}

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  email               String     @unique // stored lower-cased
  name                String
  password_hash       String
  status              UserStatus @default(active)
  /// Operates the whole installation / SaaS platform (sees and suspends all stores).
  is_platform_admin   Boolean    @default(false)
  /// Set once the person proves they own the address (link, invitation or emailed reset).
  email_verified_at   DateTime?  @db.Timestamptz(3)
  /// Two-factor sign-in (TOTP). Secrets are AES-256-GCM encrypted with APP_ENCRYPTION_KEY.
  totp_secret         String?
  /// Secret being set up, until the first code confirms it.
  totp_pending_secret String?
  totp_enabled_at     DateTime?  @db.Timestamptz(3)
  /// Last accepted 30-second step, so a code can't be used twice.
  totp_last_step      BigInt?
  last_login_at       DateTime?  @db.Timestamptz(3)
  created_at          DateTime   @default(now()) @db.Timestamptz(3)
  updated_at          DateTime   @updatedAt @db.Timestamptz(3)

  sessions            Session[]
  memberships         StoreMembership[]
  password_resets     PasswordResetToken[]
  email_verifications EmailVerificationToken[]
  recovery_codes      MfaRecoveryCode[]

  @@map("users")
}

/// One-time password reset link (emailed, or created by a platform admin). Only the hash is stored.
model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique
  expires_at DateTime  @db.Timestamptz(3)
  used_at    DateTime? @db.Timestamptz(3)
  /// Platform admin who created it (null = requested by the user).
  created_by String?   @db.Uuid
  created_at DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("password_reset_tokens")
}

/// One-time "verify your email" link. Only the hash is stored.
model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  /// The address being verified (the account's email when the link was sent).
  email      String
  token_hash String    @unique
  expires_at DateTime  @db.Timestamptz(3)
  used_at    DateTime? @db.Timestamptz(3)
  created_at DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("email_verification_tokens")
}

/// Single-use backup codes for two-factor sign-in (hashed).
model MfaRecoveryCode {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  code_hash  String
  used_at    DateTime? @db.Timestamptz(3)
  created_at DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("mfa_recovery_codes")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  user_id      String    @db.Uuid
  /// SHA-256 of the opaque session token; the raw token only lives in the cookie.
  token_hash   String    @unique
  ip           String?
  user_agent   String?
  created_at   DateTime  @default(now()) @db.Timestamptz(3)
  last_seen_at DateTime  @default(now()) @db.Timestamptz(3)
  expires_at   DateTime  @db.Timestamptz(3)
  revoked_at   DateTime? @db.Timestamptz(3)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("sessions")
}

// ───────────────────────────── Store ─────────────────────────────

enum StoreStatus {
  active
  suspended
}

model Store {
  id                String      @id @default(uuid()) @db.Uuid
  name              String
  /// ISO 4217 code; single store currency in initial release.
  currency          String      @db.Char(3)
  locale            String      @default("en-US")
  timezone          String      @default("UTC")
  contact_email     String?
  /// URL-safe, unique: the store's subdomain on the platform (e.g. "northwind").
  handle            String      @unique @db.VarChar(63)
  status            StoreStatus @default(active)
  /// Commercial plan; billing arrives later, so new stores start on "trial".
  plan              String      @default("trial") @db.VarChar(40)
  suspended_at      DateTime?   @db.Timestamptz(3)
  suspension_reason String?     @db.VarChar(500)
  created_at        DateTime    @default(now()) @db.Timestamptz(3)
  updated_at        DateTime    @updatedAt @db.Timestamptz(3)

  domains             StoreDomain[]
  roles               Role[]
  memberships         StoreMembership[]
  invitations         StoreInvitation[]
  payment_accounts    PaymentAccount[]
  customers           Customer[]
  audit_logs          AuditLog[]
  products            Product[]
  markets             Market[]
  discounts           Discount[]
  variants            ProductVariant[]
  media               MediaAsset[]
  inventory_locations InventoryLocation[]
  categories          Category[]
  collections         Collection[]
  tags                ProductTag[]

  @@map("stores")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  store_id    String   @db.Uuid
  /// Stable key, e.g. "owner", "catalog_manager".
  key         String
  name        String
  is_system   Boolean  @default(false)
  /// Permission strings from @cartforge/types PERMISSIONS.
  permissions String[]
  created_at  DateTime @default(now()) @db.Timestamptz(3)
  updated_at  DateTime @updatedAt @db.Timestamptz(3)

  store       Store             @relation(fields: [store_id], references: [id], onDelete: Cascade)
  memberships StoreMembership[]
  invitations StoreInvitation[]

  @@unique([store_id, key])
  @@map("roles")
}

enum MembershipStatus {
  active
  invited
  disabled
}

model StoreMembership {
  id         String           @id @default(uuid()) @db.Uuid
  store_id   String           @db.Uuid
  user_id    String           @db.Uuid
  role_id    String           @db.Uuid
  status     MembershipStatus @default(active)
  created_at DateTime         @default(now()) @db.Timestamptz(3)
  updated_at DateTime         @updatedAt @db.Timestamptz(3)

  store Store @relation(fields: [store_id], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role  Role  @relation(fields: [role_id], references: [id], onDelete: Restrict)

  @@unique([store_id, user_id])
  @@index([user_id])
  @@map("store_memberships")
}

/// Invitation to join a store's team (Next 1). Only the token's hash is stored.
model StoreInvitation {
  id          String    @id @default(uuid()) @db.Uuid
  store_id    String    @db.Uuid
  /// Lower-cased.
  email       String
  role_id     String    @db.Uuid
  token_hash  String    @unique
  invited_by  String?   @db.Uuid
  expires_at  DateTime  @db.Timestamptz(3)
  accepted_at DateTime? @db.Timestamptz(3)
  revoked_at  DateTime? @db.Timestamptz(3)
  created_at  DateTime  @default(now()) @db.Timestamptz(3)

  store Store @relation(fields: [store_id], references: [id], onDelete: Cascade)
  role  Role  @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@index([store_id, email])
  @@map("store_invitations")
}

// ───────────────────────────── Audit ─────────────────────────────

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  /// Null for installation-level events (e.g. login).
  store_id      String?  @db.Uuid
  actor_user_id String?  @db.Uuid
  action        String
  resource_type String
  resource_id   String?
  /// Before/after and other context. Never store secrets or raw PII here.
  metadata      Json     @default("{}")
  ip            String?
  request_id    String?
  created_at    DateTime @default(now()) @db.Timestamptz(3)

  store Store? @relation(fields: [store_id], references: [id], onDelete: SetNull)

  @@index([store_id, created_at])
  @@index([resource_type, resource_id])
  @@map("audit_logs")
}

// ───────────────────────────── Catalog ─────────────────────────────
// Uniqueness that must ignore soft-deleted rows is enforced by partial unique
// indexes created in SQL migrations (Prisma can't express them):
//   products_store_handle_live_key  (store_id, handle) WHERE deleted_at IS NULL
//   product_variants_store_sku_live_key (store_id, sku) WHERE sku IS NOT NULL AND deleted_at IS NULL

enum ProductStatus {
  draft
  active
  archived
}

enum ProductType {
  simple
  variable
}

model Product {
  id                String        @id @default(uuid()) @db.Uuid
  store_id          String        @db.Uuid
  title             String        @db.VarChar(200)
  /// Sanitized HTML. Never render unsanitized input.
  description_html  String        @default("")
  handle            String        @db.VarChar(255)
  product_type      ProductType   @default(simple)
  /// Free text in the initial release (PLAN.md §3).
  vendor            String?       @db.VarChar(120)
  status            ProductStatus @default(draft)
  taxable           Boolean       @default(true)
  requires_shipping Boolean       @default(true)
  seo_title         String?       @db.VarChar(255)
  seo_description   String?       @db.VarChar(500)
  published_at      DateTime?     @db.Timestamptz(3)
  created_by        String?       @db.Uuid
  updated_by        String?       @db.Uuid
  created_at        DateTime      @default(now()) @db.Timestamptz(3)
  updated_at        DateTime      @updatedAt @db.Timestamptz(3)
  /// Next 8 (Markets): markets this product isn't sold in.
  hidden_market_ids String[]      @default([]) @db.Uuid
  deleted_at        DateTime?     @db.Timestamptz(3)

  store       Store                  @relation(fields: [store_id], references: [id], onDelete: Cascade)
  variants    ProductVariant[]
  media       ProductMedia[]
  options     ProductOption[]
  categories  ProductCategory[]
  collections CollectionProduct[]
  tags        ProductTagAssignment[]

  @@index([store_id, status, updated_at])
  @@index([store_id, updated_at])
  @@index([store_id, created_at])
  @@index([store_id, title])
  @@map("products")
}

/// Every product has ≥1 variant; simple products have exactly one "default" variant.
/// Pricing (Sprint 2) and options/inventory (Sprint 3) extend this table.
model ProductVariant {
  id                 String    @id @default(uuid()) @db.Uuid
  store_id           String    @db.Uuid
  product_id         String    @db.Uuid
  title              String    @default("Default") @db.VarChar(255)
  sku                String?   @db.VarChar(100)
  barcode            String?   @db.VarChar(100)
  position           Int       @default(0)
  /// Money in minor units (cents) of `currency` (always the store currency, BE-005).
  price_minor        BigInt?
  compare_at_minor   BigInt?
  /// Internal only — never returned by storefront/public endpoints.
  cost_minor         BigInt?
  currency           String?   @db.Char(3)
  /// Track stock for this variant (PRD §8.4 D). Untracked variants are always available.
  inventory_tracking Boolean   @default(true)
  /// Allow orders when out of stock (PRD §9 INV-007). Off by default.
  continue_selling   Boolean   @default(false)
  /// Optional image, must be one of the product's images.
  media_asset_id     String?   @db.Uuid
  /// Sorted option-value ids joined by ","; "" for the default variant. Unique per product (live rows).
  option_signature   String    @default("") @db.VarChar(200)
  created_at         DateTime  @default(now()) @db.Timestamptz(3)
  updated_at         DateTime  @updatedAt @db.Timestamptz(3)
  deleted_at         DateTime? @db.Timestamptz(3)

  store         Store                       @relation(fields: [store_id], references: [id], onDelete: Cascade)
  product       Product                     @relation(fields: [product_id], references: [id], onDelete: Cascade)
  option_values ProductVariantOptionValue[]
  inventory     InventoryLevel[]
  movements     StockMovement[]
  cart_lines    CartLine[]
  reservations  InventoryReservation[]

  market_prices      MarketPrice[]
  @@index([product_id, position])
  @@index([store_id, barcode])
  @@map("product_variants")
}

// ───────────────────────────── Media ─────────────────────────────

enum MediaStatus {
  processing
  ready
  failed
}

/// One stored binary per (store, checksum): re-uploading the same file reuses it (PRD §8.4 B).
model MediaAsset {
  id                String      @id @default(uuid()) @db.Uuid
  store_id          String      @db.Uuid
  storage_driver    String      @db.VarChar(20)
  storage_key       String      @db.VarChar(500)
  url               String      @db.VarChar(1000)
  original_filename String?     @db.VarChar(255)
  mime_type         String      @db.VarChar(100)
  size_bytes        Int
  width             Int?
  height            Int?
  checksum_sha256   String      @db.Char(64)
  alt_text          String?     @db.VarChar(500)
  status            MediaStatus @default(ready)
  created_by        String?     @db.Uuid
  created_at        DateTime    @default(now()) @db.Timestamptz(3)
  updated_at        DateTime    @updatedAt @db.Timestamptz(3)
  deleted_at        DateTime?   @db.Timestamptz(3)

  store         Store             @relation(fields: [store_id], references: [id], onDelete: Cascade)
  derivatives   MediaDerivative[]
  references    MediaReference[]
  product_media ProductMedia[]

  @@index([store_id, created_at])
  @@map("media_assets")
}

model MediaDerivative {
  id             String   @id @default(uuid()) @db.Uuid
  media_asset_id String   @db.Uuid
  /// e.g. "thumb" (160), "medium" (640), "large" (1280)
  name           String   @db.VarChar(40)
  storage_key    String   @db.VarChar(500)
  url            String   @db.VarChar(1000)
  mime_type      String   @db.VarChar(100)
  width          Int
  height         Int
  size_bytes     Int
  created_at     DateTime @default(now()) @db.Timestamptz(3)

  asset MediaAsset @relation(fields: [media_asset_id], references: [id], onDelete: Cascade)

  @@unique([media_asset_id, name])
  @@map("media_derivatives")
}

/// Where an asset is used. Deletion is blocked while references exist (PRD §8.8 rule 9).
model MediaReference {
  id             String   @id @default(uuid()) @db.Uuid
  store_id       String   @db.Uuid
  media_asset_id String   @db.Uuid
  resource_type  String   @db.VarChar(40)
  resource_id    String   @db.Uuid
  created_at     DateTime @default(now()) @db.Timestamptz(3)

  asset MediaAsset @relation(fields: [media_asset_id], references: [id], onDelete: Cascade)

  @@unique([media_asset_id, resource_type, resource_id])
  @@index([store_id, resource_type, resource_id])
  @@map("media_references")
}

model ProductMedia {
  id             String  @id @default(uuid()) @db.Uuid
  store_id       String  @db.Uuid
  product_id     String  @db.Uuid
  media_asset_id String  @db.Uuid
  position       Int
  is_primary     Boolean @default(false)
  /// Product-specific alt text; falls back to the asset's alt text.
  alt_text       String? @db.VarChar(500)

  product Product    @relation(fields: [product_id], references: [id], onDelete: Cascade)
  asset   MediaAsset @relation(fields: [media_asset_id], references: [id], onDelete: Restrict)

  @@unique([product_id, media_asset_id])
  @@index([product_id, position])
  @@map("product_media")
}

// ───────────────────────────── Options ─────────────────────────────

model ProductOption {
  id         String   @id @default(uuid()) @db.Uuid
  store_id   String   @db.Uuid
  product_id String   @db.Uuid
  name       String   @db.VarChar(60)
  position   Int
  created_at DateTime @default(now()) @db.Timestamptz(3)
  updated_at DateTime @updatedAt @db.Timestamptz(3)

  product Product              @relation(fields: [product_id], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@index([product_id, position])
  @@map("product_options")
}

model ProductOptionValue {
  id         String   @id @default(uuid()) @db.Uuid
  store_id   String   @db.Uuid
  option_id  String   @db.Uuid
  value      String   @db.VarChar(80)
  position   Int
  created_at DateTime @default(now()) @db.Timestamptz(3)

  option   ProductOption               @relation(fields: [option_id], references: [id], onDelete: Cascade)
  variants ProductVariantOptionValue[]

  @@index([option_id, position])
  @@map("product_option_values")
}

model ProductVariantOptionValue {
  variant_id      String @db.Uuid
  option_value_id String @db.Uuid

  variant      ProductVariant     @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  option_value ProductOptionValue @relation(fields: [option_value_id], references: [id], onDelete: Cascade)

  @@id([variant_id, option_value_id])
  @@index([option_value_id])
  @@map("product_variant_option_values")
}

// ───────────────────────────── Inventory ─────────────────────────────

enum InventoryLocationStatus {
  active
  archived
}

/// Single default location per store in the first release (PRD §8.4 D).
model InventoryLocation {
  id         String                  @id @default(uuid()) @db.Uuid
  store_id   String                  @db.Uuid
  name       String                  @db.VarChar(120)
  is_default Boolean                 @default(false)
  status     InventoryLocationStatus @default(active)
  created_at DateTime                @default(now()) @db.Timestamptz(3)
  updated_at DateTime                @updatedAt @db.Timestamptz(3)

  store        Store                  @relation(fields: [store_id], references: [id], onDelete: Cascade)
  levels       InventoryLevel[]
  movements    StockMovement[]
  reservations InventoryReservation[]

  @@index([store_id])
  @@map("inventory_locations")
}

/// available = on_hand − reserved (PRD §9.3). Change only via StockMovement-producing operations.
model InventoryLevel {
  id                  String   @id @default(uuid()) @db.Uuid
  store_id            String   @db.Uuid
  variant_id          String   @db.Uuid
  location_id         String   @db.Uuid
  on_hand             Int      @default(0)
  reserved            Int      @default(0)
  low_stock_threshold Int?
  created_at          DateTime @default(now()) @db.Timestamptz(3)
  updated_at          DateTime @updatedAt @db.Timestamptz(3)

  variant  ProductVariant    @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  location InventoryLocation @relation(fields: [location_id], references: [id], onDelete: Restrict)

  @@unique([variant_id, location_id])
  @@index([store_id, on_hand])
  @@map("inventory_levels")
}

enum StockMovementType {
  initial
  received
  correction
  damaged
  shrinkage
  returned
  other
  /// Stock leaving with an order (Next 4).
  sale
}

/// Immutable ledger (PRD §8.8 rule 8, §9 INV-006). UPDATE/DELETE blocked by trigger.
model StockMovement {
  id              String            @id @default(uuid()) @db.Uuid
  store_id        String            @db.Uuid
  variant_id      String            @db.Uuid
  location_id     String            @db.Uuid
  movement_type   StockMovementType
  quantity_delta  Int
  quantity_before Int
  quantity_after  Int
  reason          String?           @db.VarChar(500)
  reference_type  String?           @db.VarChar(40)
  reference_id    String?           @db.Uuid
  actor_id        String?           @db.Uuid
  request_id      String?
  created_at      DateTime          @default(now()) @db.Timestamptz(3)

  variant  ProductVariant    @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  location InventoryLocation @relation(fields: [location_id], references: [id], onDelete: Restrict)

  @@index([variant_id, created_at])
  @@index([store_id, created_at])
  @@map("stock_movements")
}

// ───────────────────────────── Organization (PRD §8.6) ─────────────────────────────

enum CategoryStatus {
  active
  archived
}

/// Parent-child taxonomy. Depth limit and cycle prevention are enforced by the API.
model Category {
  id               String         @id @default(uuid()) @db.Uuid
  store_id         String         @db.Uuid
  parent_id        String?        @db.Uuid
  name             String         @db.VarChar(120)
  handle           String         @db.VarChar(255)
  description_html String         @default("")
  image_asset_id   String?        @db.Uuid
  seo_title        String?        @db.VarChar(255)
  seo_description  String?        @db.VarChar(500)
  status           CategoryStatus @default(active)
  sort_order       Int            @default(0)
  created_at       DateTime       @default(now()) @db.Timestamptz(3)
  updated_at       DateTime       @updatedAt @db.Timestamptz(3)

  store    Store             @relation(fields: [store_id], references: [id], onDelete: Cascade)
  parent   Category?         @relation("CategoryTree", fields: [parent_id], references: [id], onDelete: Restrict)
  children Category[]        @relation("CategoryTree")
  products ProductCategory[]

  @@unique([store_id, handle])
  @@index([store_id, parent_id, sort_order])
  @@map("categories")
}

model ProductCategory {
  product_id  String   @db.Uuid
  category_id String   @db.Uuid
  store_id    String   @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(3)

  product  Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  category Category @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@id([product_id, category_id])
  @@index([category_id])
  @@map("product_categories")
}

enum CollectionType {
  manual
  /// Reserved: rule-based collections are out of the first release (PLAN.md §3).
  automated
}

enum CollectionStatus {
  draft
  active
  archived
}

/// How a collection orders its products on the storefront.
enum CollectionSort {
  manual
  title_asc
  title_desc
  price_asc
  price_desc
  created_desc
  created_asc
}

model Collection {
  id               String           @id @default(uuid()) @db.Uuid
  store_id         String           @db.Uuid
  title            String           @db.VarChar(200)
  handle           String           @db.VarChar(255)
  description_html String           @default("")
  image_asset_id   String?          @db.Uuid
  collection_type  CollectionType   @default(manual)
  rules_json       Json?
  status           CollectionStatus @default(draft)
  sort_order       CollectionSort   @default(manual)
  seo_title        String?          @db.VarChar(255)
  seo_description  String?          @db.VarChar(500)
  created_by       String?          @db.Uuid
  updated_by       String?          @db.Uuid
  created_at       DateTime         @default(now()) @db.Timestamptz(3)
  updated_at       DateTime         @updatedAt @db.Timestamptz(3)

  store    Store               @relation(fields: [store_id], references: [id], onDelete: Cascade)
  products CollectionProduct[]

  @@unique([store_id, handle])
  @@index([store_id, status])
  @@map("collections")
}

model CollectionProduct {
  collection_id String   @db.Uuid
  product_id    String   @db.Uuid
  store_id      String   @db.Uuid
  position      Int
  created_at    DateTime @default(now()) @db.Timestamptz(3)

  collection Collection @relation(fields: [collection_id], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@id([collection_id, product_id])
  @@index([product_id])
  @@index([collection_id, position])
  @@map("collection_products")
}

model ProductTag {
  id              String   @id @default(uuid()) @db.Uuid
  store_id        String   @db.Uuid
  name            String   @db.VarChar(80)
  /// lower-cased, trimmed, inner whitespace collapsed
  normalized_name String   @db.VarChar(80)
  created_at      DateTime @default(now()) @db.Timestamptz(3)

  store       Store                  @relation(fields: [store_id], references: [id], onDelete: Cascade)
  assignments ProductTagAssignment[]

  @@unique([store_id, normalized_name])
  @@map("product_tags")
}

model ProductTagAssignment {
  product_id String @db.Uuid
  tag_id     String @db.Uuid

  product Product    @relation(fields: [product_id], references: [id], onDelete: Cascade)
  tag     ProductTag @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([product_id, tag_id])
  @@index([tag_id])
  @@map("product_tag_assignments")
}

/// Created when a published product's handle changes (PRD §8.4 A), so old links keep working.
model UrlRedirect {
  id            String   @id @default(uuid()) @db.Uuid
  store_id      String   @db.Uuid
  path_from     String   @db.VarChar(500)
  path_to       String   @db.VarChar(500)
  resource_type String   @db.VarChar(40)
  resource_id   String   @db.Uuid
  created_at    DateTime @default(now()) @db.Timestamptz(3)

  @@unique([store_id, path_from])
  @@index([store_id, resource_type, resource_id])
  @@map("url_redirects")
}

/// Transactional outbox (BE-010): written in the same transaction as the change;
/// a worker delivers webhooks and invalidates storefront caches (PRD §8.8 rule 10).
model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  store_id      String    @db.Uuid
  event_type    String    @db.VarChar(80)
  resource_type String    @db.VarChar(40)
  resource_id   String    @db.Uuid
  payload       Json      @default("{}")
  created_at    DateTime  @default(now()) @db.Timestamptz(3)
  processed_at  DateTime? @db.Timestamptz(3)
  attempts      Int       @default(0)

  @@index([processed_at, created_at])
  @@index([store_id, created_at])
  @@map("outbox_events")
}

// ───────────────────────────── Orders (minimal, Sprint 5) ─────────────────────────────
// Only what PRD §8.8 rule 7 / §29.2 #32 need: order lines are immutable snapshots that
// never read live product data. The full orders module (Next 6) extends these tables.

enum OrderStatus {
  pending
  processing
  on_hold
  completed
  canceled
  refunded
}

enum PaymentStatus {
  pending
  authorized
  paid
  partially_refunded
  refunded
  voided
  failed
}

enum FulfillmentStatus {
  unfulfilled
  partially_fulfilled
  fulfilled
}

/// Financial fields are immutable after insert (trigger); statuses move with payment and fulfillment.
model Order {
  id                   String            @id @default(uuid()) @db.Uuid
  store_id             String            @db.Uuid
  /// Human-facing number, sequential per store ("1001").
  number               String            @db.VarChar(40)
  currency             String            @db.Char(3)
  status               OrderStatus       @default(pending)
  payment_status       PaymentStatus     @default(pending)
  fulfillment_status   FulfillmentStatus @default(unfulfilled)
  email                String?           @db.VarChar(254)
  phone                String?           @db.VarChar(30)
  shipping_address     Json?
  billing_address      Json?
  /// {id, name, price_minor} at purchase time.
  shipping_method      Json?
  payment_method       String?           @db.VarChar(40)
  payment_method_label String?           @db.VarChar(80)
  subtotal_minor       BigInt            @default(0)
  discount_minor       BigInt            @default(0)
  shipping_minor       BigInt            @default(0)
  tax_minor            BigInt            @default(0)
  total_minor          BigInt            @default(0)
  prices_include_tax   Boolean           @default(false)
  tax_rate_bps         Int               @default(0)
  tax_label            String?           @db.VarChar(40)
  custom_fields        Json              @default("[]")
  terms_accepted_at    DateTime?         @db.Timestamptz(3)
  customer_id          String?           @db.Uuid
  checkout_id          String?           @unique @db.Uuid
  /// sha256 of the secret in the customer's order-status link.
  access_key_hash      String?           @db.Char(64)
  source               String            @default("storefront") @db.VarChar(20)
  placed_at            DateTime          @default(now()) @db.Timestamptz(3)
  /// Next 6: cancellation.
  canceled_at          DateTime?         @db.Timestamptz(3)
  cancel_reason        String?           @db.VarChar(40)
  /// Sum of recorded refunds (kept in step with the refunds table).
  /// Next 8: discounts applied [{id, title, code, kind, amount_minor}].
  discounts            Json              @default("[]")
  /// Markets: where it was sold, the rate used and its value in the store currency.
  market_id            String?           @db.Uuid
  /// Store-currency units per 1 order-currency unit (1 when the same currency).
  fx_rate              Decimal?          @db.Decimal(24, 10)
  store_currency       String?           @db.Char(3)
  store_total_minor    BigInt?
  refunded_minor       BigInt            @default(0)
  created_at           DateTime          @default(now()) @db.Timestamptz(3)
  updated_at           DateTime          @default(now()) @updatedAt @db.Timestamptz(3)

  items        OrderItem[]
  events       OrderEvent[]
  payments     Payment[]
  fulfillments Fulfillment[]
  refunds      Refund[]
  customer     Customer?     @relation(fields: [customer_id], references: [id], onDelete: SetNull)

  @@unique([store_id, number])
  @@index([store_id, placed_at])
  @@index([store_id, status, placed_at])
  @@index([store_id, email])
  @@map("orders")
}

/// Order timeline (PRD §15): placed, payment, status changes, notes.
model OrderEvent {
  id         String   @id @default(uuid()) @db.Uuid
  store_id   String   @db.Uuid
  order_id   String   @db.Uuid
  type       String   @db.VarChar(60)
  message    String   @db.VarChar(500)
  data       Json     @default("{}")
  actor_id   String?  @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(3)

  order Order @relation(fields: [order_id], references: [id], onDelete: Restrict)

  @@index([order_id, created_at])
  @@map("order_events")
}

/// One payment attempt per order (Payment Hub, Next 5, adds providers and events).
model Payment {
  id                 String        @id @default(uuid()) @db.Uuid
  store_id           String        @db.Uuid
  order_id           String        @db.Uuid
  provider           String        @db.VarChar(40)
  status             PaymentStatus @default(pending)
  amount_minor       BigInt
  currency           String        @db.Char(3)
  provider_reference String?       @db.VarChar(200)
  /// Shown to the customer (e.g. bank details) — copied from settings at purchase time.
  instructions       String?       @db.VarChar(1000)
  /// Next 5 (online providers): "test" or "live", the provider's charge id used for refunds,
  /// and why the last attempt failed.
  mode               String?       @db.VarChar(10)
  provider_charge_id String?       @db.VarChar(200)
  failure_reason     String?       @db.VarChar(500)
  paid_at            DateTime?     @db.Timestamptz(3)
  created_at         DateTime      @default(now()) @db.Timestamptz(3)
  updated_at         DateTime      @updatedAt @db.Timestamptz(3)

  order  Order          @relation(fields: [order_id], references: [id], onDelete: Restrict)
  events PaymentEvent[]

  @@index([order_id])
  @@index([provider, provider_reference])
  @@map("payments")
}

/// A store's connection to an online payment provider (Next 5). Credentials are
/// AES-256-GCM encrypted with APP_ENCRYPTION_KEY; the API never returns them.
model PaymentAccount {
  id          String   @id @default(uuid()) @db.Uuid
  store_id    String   @db.Uuid
  /// "stripe" | "safepay" | "jazzcash" | "easypaisa"
  provider    String   @db.VarChar(40)
  /// "test" (sandbox) or "live"
  mode        String   @default("test") @db.VarChar(10)
  enabled     Boolean  @default(false)
  credentials String
  created_at  DateTime @default(now()) @db.Timestamptz(3)
  updated_at  DateTime @updatedAt @db.Timestamptz(3)

  store Store @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@unique([store_id, provider])
  @@map("payment_accounts")
}

/// Every verified message from a provider (webhook or signed return), recorded once.
model PaymentEvent {
  id           String   @id @default(uuid()) @db.Uuid
  store_id     String   @db.Uuid
  payment_id   String?  @db.Uuid
  provider     String   @db.VarChar(40)
  /// Provider's id for this message (event id, or reference + outcome), unique per provider.
  external_id  String   @db.VarChar(255)
  /// "paid" | "failed" | "canceled" | "refunded" | "ignored"
  outcome      String   @db.VarChar(20)
  source       String   @db.VarChar(20)
  amount_minor BigInt?
  payload      Json     @default("{}")
  created_at   DateTime @default(now()) @db.Timestamptz(3)

  payment Payment? @relation(fields: [payment_id], references: [id], onDelete: Restrict)

  @@unique([store_id, provider, external_id])
  @@index([payment_id])
  @@map("payment_events")
}

/// A shipment of some or all of an order's items (Next 6).
model Fulfillment {
  id               String    @id @default(uuid()) @db.Uuid
  store_id         String    @db.Uuid
  order_id         String    @db.Uuid
  tracking_company String?   @db.VarChar(80)
  tracking_number  String?   @db.VarChar(120)
  tracking_url     String?   @db.VarChar(500)
  shipped_at       DateTime  @default(now()) @db.Timestamptz(3)
  delivered_at     DateTime? @db.Timestamptz(3)
  created_by       String?   @db.Uuid
  created_at       DateTime  @default(now()) @db.Timestamptz(3)

  order Order             @relation(fields: [order_id], references: [id], onDelete: Restrict)
  items FulfillmentItem[]

  @@index([store_id, order_id])
  @@map("fulfillments")
}

model FulfillmentItem {
  id             String @id @default(uuid()) @db.Uuid
  fulfillment_id String @db.Uuid
  order_item_id  String @db.Uuid
  quantity       Int

  fulfillment Fulfillment @relation(fields: [fulfillment_id], references: [id], onDelete: Cascade)
  order_item  OrderItem   @relation(fields: [order_item_id], references: [id], onDelete: Restrict)

  @@index([order_item_id])
  @@map("fulfillment_items")
}

/// Money given back (recorded; Payment Hub, Next 5, sends it through the provider). Append-only.
model Refund {
  id                 String   @id @default(uuid()) @db.Uuid
  store_id           String   @db.Uuid
  order_id           String   @db.Uuid
  amount_minor       BigInt
  currency           String   @db.Char(3)
  reason             String?  @db.VarChar(500)
  /// "manual": money returned outside CartForge · otherwise the provider that sent it back.
  method             String   @default("manual") @db.VarChar(40)
  provider_reference String?  @db.VarChar(200)
  created_by         String?  @db.Uuid
  created_at         DateTime @default(now()) @db.Timestamptz(3)

  order Order        @relation(fields: [order_id], references: [id], onDelete: Restrict)
  items RefundItem[]

  @@index([store_id, order_id])
  @@map("refunds")
}

model RefundItem {
  id            String  @id @default(uuid()) @db.Uuid
  refund_id     String  @db.Uuid
  order_item_id String  @db.Uuid
  quantity      Int
  restocked     Boolean @default(false)

  refund     Refund    @relation(fields: [refund_id], references: [id], onDelete: Restrict)
  order_item OrderItem @relation(fields: [order_item_id], references: [id], onDelete: Restrict)

  @@index([order_item_id])
  @@map("refund_items")
}

enum CartStatus {
  active
  converted
}

/// Guest carts addressed by a secret token (only its hash is stored). customer_id arrives in Next 7.
model Cart {
  id          String     @id @default(uuid()) @db.Uuid
  store_id    String     @db.Uuid
  token_hash  String     @unique @db.Char(64)
  market_id   String?    @db.Uuid
  currency    String     @db.Char(3)
  status      CartStatus @default(active)
  customer_id String?    @db.Uuid
  created_at  DateTime   @default(now()) @db.Timestamptz(3)
  updated_at  DateTime   @updatedAt @db.Timestamptz(3)

  lines    CartLine[]
  checkout Checkout?

  @@index([store_id, updated_at])
  @@map("carts")
}

model CartLine {
  id               String   @id @default(uuid()) @db.Uuid
  cart_id          String   @db.Uuid
  store_id         String   @db.Uuid
  variant_id       String   @db.Uuid
  quantity         Int
  /// Price the shopper last saw; a different current price is flagged, then adopted.
  seen_price_minor BigInt?
  created_at       DateTime @default(now()) @db.Timestamptz(3)
  updated_at       DateTime @updatedAt @db.Timestamptz(3)

  cart    Cart           @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variant_id], references: [id], onDelete: Cascade)

  @@unique([cart_id, variant_id])
  @@map("cart_lines")
}

enum CheckoutStatus {
  open
  completed
}

model Checkout {
  id                 String         @id @default(uuid()) @db.Uuid
  store_id           String         @db.Uuid
  cart_id            String         @unique @db.Uuid
  status             CheckoutStatus @default(open)
  email              String?        @db.VarChar(254)
  phone              String?        @db.VarChar(30)
  shipping_address   Json?
  /// null = same as shipping.
  billing_address    Json?
  shipping_method_id String?        @db.Uuid
  payment_method     String?        @db.VarChar(40)
  custom_fields      Json           @default("{}")
  terms_accepted     Boolean        @default(false)
  reserved_until     DateTime?      @db.Timestamptz(3)
  /// Next 8: the discount code the shopper entered.
  discount_code      String?        @db.VarChar(40)
  order_id           String?        @unique @db.Uuid
  created_at         DateTime       @default(now()) @db.Timestamptz(3)
  updated_at         DateTime       @updatedAt @db.Timestamptz(3)

  cart         Cart                   @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  reservations InventoryReservation[]

  @@map("checkouts")
}

enum ReservationStatus {
  active
  released
  consumed
  expired
}

/// Stock held for a checkout (PRD INV-003/004). inventory_levels.reserved = Σ active quantities.
model InventoryReservation {
  id          String            @id @default(uuid()) @db.Uuid
  store_id    String            @db.Uuid
  variant_id  String            @db.Uuid
  location_id String            @db.Uuid
  checkout_id String            @db.Uuid
  quantity    Int
  status      ReservationStatus @default(active)
  expires_at  DateTime          @db.Timestamptz(3)
  created_at  DateTime          @default(now()) @db.Timestamptz(3)
  updated_at  DateTime          @updatedAt @db.Timestamptz(3)

  variant  ProductVariant    @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  location InventoryLocation @relation(fields: [location_id], references: [id], onDelete: Restrict)
  checkout Checkout          @relation(fields: [checkout_id], references: [id], onDelete: Cascade)

  @@index([checkout_id])
  @@index([store_id, status, expires_at])
  @@map("inventory_reservations")
}

/// One row per store; absent = defaults (see @cartforge/checkout-engine).
model CheckoutSettings {
  store_id                   String   @id @db.Uuid
  tax_rate_bps               Int      @default(0)
  tax_label                  String   @default("Tax") @db.VarChar(40)
  prices_include_tax         Boolean  @default(false)
  tax_shipping               Boolean  @default(false)
  /// Next 7: [{country, region, rate_bps, label}] overriding tax_rate_bps.
  tax_rules                  Json     @default("[]")
  phone                      String   @default("optional") @db.VarChar(10)
  reservation_minutes        Int      @default(15)
  terms_required             Boolean  @default(false)
  terms_label                String   @default("I agree to the terms of service") @db.VarChar(200)
  terms_url                  String   @default("") @db.VarChar(500)
  custom_fields              Json     @default("[]")
  cod_enabled                Boolean  @default(false)
  cod_instructions           String   @default("") @db.VarChar(1000)
  bank_transfer_enabled      Boolean  @default(false)
  bank_transfer_instructions String   @default("") @db.VarChar(1000)
  /// Next 5: pay by mobile wallet / Raast / IBAN transfer (Pakistan), confirmed by the merchant.
  wallet_enabled             Boolean  @default(false)
  wallet_jazzcash            String   @default("") @db.VarChar(20)
  wallet_easypaisa           String   @default("") @db.VarChar(20)
  wallet_raast_id            String   @default("") @db.VarChar(40)
  wallet_iban                String   @default("") @db.VarChar(34)
  wallet_account_title       String   @default("") @db.VarChar(100)
  wallet_note                String   @default("") @db.VarChar(500)
  updated_by                 String?  @db.Uuid
  updated_at                 DateTime @updatedAt @db.Timestamptz(3)

  @@map("checkout_settings")
}

model ShippingMethod {
  id              String   @id @default(uuid()) @db.Uuid
  store_id        String   @db.Uuid
  name            String   @db.VarChar(80)
  description     String?  @db.VarChar(200)
  price_minor     BigInt
  free_over_minor BigInt?
  countries       String[] @default([])
  /// Next 7: provinces/states and cities (empty = all), order-value limits,
  /// per-extra-item charge and delivery estimate in days.
  regions         String[] @default([])
  cities          String[] @default([])
  min_order_minor BigInt?
  max_order_minor BigInt?
  per_item_minor  BigInt   @default(0)
  min_days        Int?
  max_days        Int?
  active          Boolean  @default(true)
  position        Int      @default(0)
  created_at      DateTime @default(now()) @db.Timestamptz(3)
  updated_at      DateTime @updatedAt @db.Timestamptz(3)

  @@index([store_id, position])
  @@map("shipping_methods")
}

enum DomainKind {
  /// <handle>.<PLATFORM_DOMAIN>, created automatically.
  platform
  /// Merchant-owned, verified by DNS TXT record.
  custom
}

enum DomainStatus {
  pending
  active
}

/// Hostnames that serve a store's storefront. A hostname belongs to at most one store.
model StoreDomain {
  id                 String       @id @default(uuid()) @db.Uuid
  store_id           String       @db.Uuid
  hostname           String       @unique @db.VarChar(253)
  kind               DomainKind
  status             DomainStatus @default(pending)
  is_primary         Boolean      @default(false)
  verification_token String       @db.VarChar(64)
  verified_at        DateTime?    @db.Timestamptz(3)
  /// Last verification problem shown to the merchant.
  last_error         String?      @db.VarChar(300)
  created_at         DateTime     @default(now()) @db.Timestamptz(3)
  updated_at         DateTime     @updatedAt @db.Timestamptz(3)

  store Store @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@index([store_id])
  @@map("store_domains")
}

/// Retry-safe endpoints (BE-009): the first response for a key is stored and replayed.
model IdempotencyKey {
  id           String   @id @default(uuid()) @db.Uuid
  store_id     String   @db.Uuid
  scope        String   @db.VarChar(60)
  key          String   @db.VarChar(200)
  request_hash String   @db.Char(64)
  /// null while the first request is still running.
  status_code  Int?
  response     Json?
  created_at   DateTime @default(now()) @db.Timestamptz(3)

  @@unique([store_id, scope, key])
  @@index([created_at])
  @@map("idempotency_keys")
}

/// Per-store counters (order numbers).
model StoreSequence {
  store_id String @db.Uuid
  name     String @db.VarChar(40)
  value    Int    @default(0)

  @@id([store_id, name])
  @@map("store_sequences")
}

/// Snapshot of what was sold. product_id/variant_id are informational links only
/// (SET NULL if the row is ever hard-deleted); all display/financial data is copied.
model OrderItem {
  id               String   @id @default(uuid()) @db.Uuid
  store_id         String   @db.Uuid
  order_id         String   @db.Uuid
  product_id       String?  @db.Uuid
  variant_id       String?  @db.Uuid
  product_title    String   @db.VarChar(200)
  variant_title    String   @db.VarChar(255)
  sku              String?  @db.VarChar(100)
  option_values    Json     @default("[]")
  quantity         Int
  unit_price_minor BigInt
  tax_minor        BigInt   @default(0)
  discount_minor   BigInt   @default(0)
  currency         String   @db.Char(3)
  created_at       DateTime @default(now()) @db.Timestamptz(3)

  order             Order             @relation(fields: [order_id], references: [id], onDelete: Restrict)
  fulfillment_items FulfillmentItem[]
  refund_items      RefundItem[]

  @@index([order_id])
  @@index([store_id, product_id])
  @@map("order_items")
}

// ───────────────────────────── Customers (Next 7) ─────────────────────────────

/// A shopper of one store: created by their first order (guest) or by signing up.
model Customer {
  id                String   @id @default(uuid()) @db.Uuid
  store_id          String   @db.Uuid
  /// Lower-cased; one customer per email per store.
  email             String   @db.VarChar(254)
  first_name        String?  @db.VarChar(100)
  last_name         String?  @db.VarChar(100)
  phone             String?  @db.VarChar(30)
  /// Set when they create an account; guests have none.
  password_hash     String?
  accepts_marketing Boolean  @default(false)
  /// Staff-only.
  note              String?  @db.VarChar(2000)
  tags              String[] @default([])
  created_at        DateTime @default(now()) @db.Timestamptz(3)
  updated_at        DateTime @updatedAt @db.Timestamptz(3)

  store     Store             @relation(fields: [store_id], references: [id], onDelete: Cascade)
  addresses CustomerAddress[]
  sessions  CustomerSession[]
  tokens    CustomerToken[]
  orders    Order[]

  @@unique([store_id, email])
  @@index([store_id, created_at])
  @@map("customers")
}

model CustomerAddress {
  id          String   @id @default(uuid()) @db.Uuid
  store_id    String   @db.Uuid
  customer_id String   @db.Uuid
  /// Same shape as order addresses (CommerceAddress).
  address     Json
  is_default  Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz(3)
  updated_at  DateTime @updatedAt @db.Timestamptz(3)

  customer Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([customer_id])
  @@map("customer_addresses")
}

/// Storefront sign-in, separate from staff sessions. Only the token's hash is stored.
model CustomerSession {
  id           String    @id @default(uuid()) @db.Uuid
  store_id     String    @db.Uuid
  customer_id  String    @db.Uuid
  token_hash   String    @unique
  created_at   DateTime  @default(now()) @db.Timestamptz(3)
  last_seen_at DateTime  @default(now()) @db.Timestamptz(3)
  expires_at   DateTime  @db.Timestamptz(3)
  revoked_at   DateTime? @db.Timestamptz(3)

  customer Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([customer_id])
  @@map("customer_sessions")
}

/// One-time links for customers (password reset). Only the hash is stored.
model CustomerToken {
  id          String    @id @default(uuid()) @db.Uuid
  customer_id String    @db.Uuid
  purpose     String    @db.VarChar(20)
  token_hash  String    @unique
  expires_at  DateTime  @db.Timestamptz(3)
  used_at     DateTime? @db.Timestamptz(3)
  created_at  DateTime  @default(now()) @db.Timestamptz(3)

  customer Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([customer_id])
  @@map("customer_tokens")
}

/// Markets: a group of countries sold to in one currency (PRD §16 international selling).
model Market {
  id              String   @id @default(uuid()) @db.Uuid
  store_id        String   @db.Uuid
  name            String   @db.VarChar(60)
  currency        String   @db.Char(3)
  countries       String[] @default([])
  is_primary      Boolean  @default(false)
  active          Boolean  @default(true)
  /// manual | live
  pricing_mode    String   @default("manual") @db.VarChar(10)
  /// Store-currency units per 1 market unit, as the merchant entered it.
  manual_rate     Decimal? @db.Decimal(24, 10)
  adjustment_bps  Int      @default(0)
  rounding        String   @default("none") @db.VarChar(10)
  payment_methods String[] @default([])
  created_at      DateTime @default(now()) @db.Timestamptz(3)
  updated_at      DateTime @updatedAt @db.Timestamptz(3)

  store  Store         @relation(fields: [store_id], references: [id], onDelete: Cascade)
  prices MarketPrice[]

  @@unique([store_id, name])
  @@index([store_id])
  @@map("markets")
}

/// A fixed price for a variant in a market (overrides conversion).
model MarketPrice {
  market_id        String  @db.Uuid
  variant_id       String  @db.Uuid
  price_minor      BigInt
  compare_at_minor BigInt?

  market  Market         @relation(fields: [market_id], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variant_id], references: [id], onDelete: Cascade)

  @@id([market_id, variant_id])
  @@index([variant_id])
  @@map("market_prices")
}

/// Latest exchange rates from the configured provider (quote units per 1 base unit).
model FxRate {
  base       String   @db.Char(3)
  quote      String   @db.Char(3)
  rate       Decimal  @db.Decimal(24, 10)
  fetched_at DateTime @db.Timestamptz(3)

  @@id([base, quote])
  @@map("fx_rates")
}

/// Next 8: discount codes and automatic discounts.
model Discount {
  id                 String    @id @default(uuid()) @db.Uuid
  store_id           String    @db.Uuid
  title              String    @db.VarChar(120)
  /// code | automatic
  method             String    @db.VarChar(10)
  /// Upper-case; unique per store.
  code               String?   @db.VarChar(40)
  /// order | products | bxgy | shipping
  kind               String    @db.VarChar(10)
  /// percent | fixed
  value_type         String    @default("percent") @db.VarChar(10)
  /// Basis points (percent) or store-currency minor units (fixed).
  value              BigInt    @default(0)
  /// {all, product_ids, collection_ids} — for bxgy, the items customers get.
  target             Json
  /// bxgy: {quantity, target, get_quantity, max_uses}
  buy                Json?
  min_subtotal_minor BigInt?
  min_quantity       Int?
  starts_at          DateTime  @default(now()) @db.Timestamptz(3)
  ends_at            DateTime? @db.Timestamptz(3)
  usage_limit        Int?
  once_per_customer  Boolean   @default(false)
  combines           Boolean   @default(false)
  market_ids         String[]  @default([]) @db.Uuid
  enabled            Boolean   @default(true)
  used_count         Int       @default(0)
  created_at         DateTime  @default(now()) @db.Timestamptz(3)
  updated_at         DateTime  @updatedAt @db.Timestamptz(3)

  store       Store                @relation(fields: [store_id], references: [id], onDelete: Cascade)
  redemptions DiscountRedemption[]

  @@unique([store_id, code])
  @@index([store_id, method, enabled])
  @@map("discounts")
}

/// One use of a discount by an order (usage limits, once per customer).
model DiscountRedemption {
  id          String   @id @default(uuid()) @db.Uuid
  discount_id String   @db.Uuid
  order_id    String   @db.Uuid
  /// Lower-cased customer email.
  email       String   @db.VarChar(254)
  amount_minor BigInt
  created_at  DateTime @default(now()) @db.Timestamptz(3)

  discount Discount @relation(fields: [discount_id], references: [id], onDelete: Cascade)

  @@unique([discount_id, order_id])
  @@index([discount_id, email])
  @@map("discount_redemptions")
}
