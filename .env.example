# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info

# --- Database / queue ---
DATABASE_URL=postgresql://cartforge:cartforge@localhost:5432/cartforge?schema=public
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=4000
# Origin(s) the admin is served from, comma-separated; used for CORS + CSRF origin checks.
ADMIN_ORIGIN=http://localhost:3000
# Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_TTL_HOURS=168
# 32-byte base64 key for encrypting integration secrets at rest (BE-008).
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Hosted demos only (see docs/DEPLOY-VERCEL.md): CARTFORGE_DEMO_SEED=true + a private SEED_PASSWORD.
# CARTFORGE_DEMO_SEED=false
# SEED_PASSWORD=

# --- Admin (Next.js) ---
# Where the admin's /api/* rewrite forwards to in development.
API_URL=http://localhost:4000

# --- Object storage (Sprint 2) ---
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=cartforge-media
S3_ACCESS_KEY=cartforge
S3_SECRET_KEY=cartforge-secret

# --- Storefront (Next 2) ---
# Public storefront origin: canonical URLs, sitemap, and preview links from the admin.
STOREFRONT_URL=http://localhost:3100
# Which store the storefront shows (defaults to the seeded demo store in development).
STOREFRONT_STORE_ID=00000000-0000-4000-8000-000000000001
# The API calls this after catalog changes so shoppers see edits immediately.
STOREFRONT_REVALIDATE_URL=http://localhost:3100/api/revalidate
# Shared by API and storefront. Generate with: openssl rand -hex 24
STOREFRONT_REVALIDATE_SECRET=
